# Python 快取與編譯檔
__pycache__/
*.py[cod]
*.class
*.so

# 虛擬環境
venv/
.venv/
env/
ENV/

# 環境變數與機密金鑰 (嚴禁提交)
.env
.env.local
.env.*.local

# 本地專案配置 (包含私人 Email 與內部路徑，上傳使用 projects.example.json)
projects.json
!projects.example.json
*.backup.json
projects_backup_*.json

# 本地 SQLite 資料庫 (嚴禁提交生產/測試本機資料庫)
data/*.db
data/*.db-wal
data/*.db-shm
!data/.gitkeep

# 專案異常生命週期運行狀態快取
reports/**/issue_state.json

# 本地鏡像專案代碼 (方案 B 自動同步之倉庫，避免重複追蹤)
repos/

# 測試與靜態分析快取
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# 編輯器與系統暫存
.vscode/
.idea/
.DS_Store
Thumbs.db

# 產生的診斷日誌報表與狀態快取 (嚴禁提交，各機器自行生成)
reports/*
!reports/.gitkeep

# 經驗案例暫存 (保留 gitkeep)
!knowledge_base/cases/.gitkeep
