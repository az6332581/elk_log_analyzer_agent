# Elasticsearch 設定
ES_HOST=http://192.168.10.135:9200
ES_INDEX=logs-*
ES_USER=elastic
ES_PASSWORD=your_elasticsearch_password_here

# Gemini API 金鑰 (可以使用 1.5 Flash，分析速度快又划算)
GEMINI_API_KEY=your_gemini_api_key_here

# 運行環境 (例如 production / staging / development)
APP_ENV=production

# ── SMTP 郵件告警通知設定 ──
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
# 收件人郵箱 (支援逗號分隔多位收件人，例如: user1@example.com, user2@example.com)
EMAIL_RECEIVER=your_email@gmail.com

# ── 定時巡檢設定 ──
# 巡檢掃描範圍 (小時，例如 24 或 168)
SCAN_HOURS=24
# 巡檢間隔時間 (分鐘，預設 240 分鐘即 4 小時)
SCAN_INTERVAL_MINUTES=240

# ── 通知 Webhook (可選，Discord / Slack 格式) ──
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
