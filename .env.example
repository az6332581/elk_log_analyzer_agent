# =============================================================================
# SRE Sentinel AI Agent 環境變數配置範本 (.env.example)
# =============================================================================

# ── 1. 資料庫持久化 (支援 SQLite WAL 或 MySQL/PostgreSQL) ──
# 預設使用本機 SQLite (目錄會自動掛載於 ./data)
DATABASE_URL=sqlite:///./data/sre_sentinel.db
# 若切換為 MySQL 範例:
# DATABASE_URL=mysql+pymysql://root:password@192.168.10.135:3306/sre_sentinel?charset=utf8mb4

# ── 2. Elasticsearch 日誌伺服器連線 ──
ES_HOST=http://192.168.10.135:9200
ES_INDEX=logs-*
ES_USER=elastic
ES_PASSWORD=your_elasticsearch_password_here

# ── 3. 大語言模型 (LLM / NCHC / Gemini) ──
# 國網 NCHC 或自建 OpenAI 相容端點:
LLM_ENDPOINT=https://portal.genai.nchc.org.tw/api/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemma-4-26B-A4B-it

# 若使用 Google 官方 Gemini 原生 API (選填):
GEMINI_API_KEY=your_gemini_api_key_here

# 運行環境 (例如 production / staging / development)
APP_ENV=production

# ── 4. GitLab 整合與自癒 CI/CD ──
GITLAB_URL=http://192.168.20.112:8929
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_PROJECT_ID=15
GITLAB_TRIGGER_TOKEN=your_pipeline_trigger_token

# ── 5. SMTP 郵件告警通知設定 ──
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
# 收件人郵箱 (支援逗號分隔多位收件人，如: user1@example.com, user2@example.com)
EMAIL_RECEIVER=your_email@gmail.com

# ── 6. 即時巡檢與排程排定 ──
# 巡檢掃描範圍 (小時，例如 24 或 168)
SCAN_HOURS=24
# 巡檢間隔時間 (分鐘，預設 60 分鐘即 1 小時)
SCAN_INTERVAL_MINUTES=60

# ── 7. ChatOps 伺服器監聽 ──
SERVER_PORT=8300
SERVER_HOST=0.0.0.0
CHATOPS_BASE_URL=http://localhost:8300

# ── 8. Webhook 通知 (可選，Discord / Slack 格式) ──
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
